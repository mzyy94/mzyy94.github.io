---
import dateFormat from "@/lib/utils/dateFormat";
import { plainify } from "@/lib/utils/textConverter";
import { getSinglePage } from "@/lib/contentParser.astro";
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const { slug } = Astro.props;
const posts = await getSinglePage("blog");
const post = posts.find((post) => post.id.includes(slug))!;
const { title, image, date } = post.data;
const description = plainify(post.body || post.data.description || "").slice(0, 120);
const href = `/blog/${post.id}`;
const domain = new URL(config.site.base_url).hostname;
const meta = [domain, date && dateFormat(date)].filter(Boolean).join(" · ");
---

<figure class="not-prose">
  <a
    href={href}
    class="group flex overflow-hidden rounded-lg border border-border dark:border-darkmode-border bg-body dark:bg-darkmode-body no-underline! hover:shadow-md transition-shadow duration-200"
  >
    <div class="flex min-w-0 flex-1 flex-col justify-center gap-1 px-4 py-3">
      <p class="m-0 font-semibold text-text-dark dark:text-darkmode-text-dark leading-snug line-clamp-2 group-hover:text-primary dark:group-hover:text-darkmode-primary transition-colors">
        {title}
      </p>
      {description && (
        <p class="m-0 text-sm text-text-light dark:text-darkmode-text-light leading-relaxed line-clamp-2">
          {description}
        </p>
      )}
      <figcaption class="flex items-center gap-1.5 text-xs text-text-light dark:text-darkmode-text-light">
        <img
          src={config.site.favicon}
          alt=""
          width={14}
          height={14}
          class="m-0 rounded-sm"
          aria-hidden="true"
        />
        <span>{meta}</span>
      </figcaption>
    </div>
    {image && (
      <div class="hidden sm:block flex-shrink-0 w-[160px] md:w-[200px]" aria-hidden="true">
        <ImageMod
          class="m-0 h-full w-full object-cover"
          src={image}
          alt={title}
          width={200}
          height={120}
          format="webp"
        />
      </div>
    )}
  </a>
</figure>
